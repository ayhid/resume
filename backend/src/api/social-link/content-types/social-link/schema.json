{
  "kind": "collectionType",
  "collectionName": "social_links",
  "info": {
    "singularName": "social-link",
    "pluralName": "social-links",
    "displayName": "Social Link",
    "description": "Social media and professional links"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
