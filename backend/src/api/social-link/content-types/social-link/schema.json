      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "iconType": {
      "type": "enumeration",
      "enum": ["devicon", "svg", "none"],
      "default": "devicon"
    },
    "label": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
