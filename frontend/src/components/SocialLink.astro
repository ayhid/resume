---
interface Props {
  platform: string;
  url: string;
  icon: string;
  iconType: 'devicon' | 'svg' | 'none';
  label: string;
}

const { platform, url, icon, iconType, label } = Astro.props;
const isLink = url && !url.startsWith('');
const Tag = url ? 'a' : 'span';
---

{url ? (
  <a href={url} target={url.startsWith('mailto:') ? undefined : '_blank'} rel={url.startsWith('mailto:') ? undefined : 'noopener'} class="flex items-center gap-2 text-slate-600 hover:text-purple-600 transition-colors">
    {iconType === 'svg' && platform === 'email' && (
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    )}
    {iconType === 'svg' && platform === 'medium' && (
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
    )}
    {iconType === 'devicon' && icon && (
      <i class={icon}></i>
    )}
    {label}
  </a>
) : (
  <span class="flex items-center gap-2 text-slate-600">
    {iconType === 'svg' && platform === 'location' && (
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    )}
    {label}
  </span>
)}
