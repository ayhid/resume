---
import type { CtaSection as CtaSectionType, Locale } from '../lib/types';
import ContactForm from './ContactForm.tsx';

interface Props {
  cta: CtaSectionType;
  locale: Locale;
}

const { cta, locale } = Astro.props;
---

<section class="mt-12 animate-in delay-3 print:hidden">
  <div class="cta-section">
    <div class="text-center mb-8">
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">{cta.heading}</h2>
      <p class="text-purple-100 mb-6 max-w-lg mx-auto">{cta.description}</p>
      <div class="flex flex-wrap justify-center gap-4">
        {cta.buttons?.map((button) => (
          <a
            href={button.url}
            target={button.url.startsWith('mailto:') ? undefined : '_blank'}
            rel={button.url.startsWith('mailto:') ? undefined : 'noopener'}
            class={`btn ${button.style === 'primary' ? 'btn-white' : 'btn-outline-white'}`}
          >
            {button.iconType === 'email' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            )}
            {button.iconType === 'calendar' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            )}
            {button.label}
          </a>
        ))}
      </div>
    </div>

    <div class="max-w-xl mx-auto">
      <ContactForm client:visible locale={locale} />
    </div>
  </div>
</section>
