---
import LanguageSwitch from './LanguageSwitch.astro';
import PdfButton from './PdfButton.astro';
import SocialLink from './SocialLink.astro';
import type { ResumeProfile, SocialLink as SocialLinkType, Locale } from '../lib/types';

interface Props {
  profile: ResumeProfile;
  socialLinks: SocialLinkType[];
  locale: Locale;
}

const { profile, socialLinks, locale } = Astro.props;
---

<header class="sticky-header mb-8 animate-in print:static print:bg-transparent print:backdrop-blur-none">
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-slate-900 mb-2 tracking-tight">
        {profile.fullName}
      </h1>
      <p class="text-xl text-purple-600 font-medium">{profile.jobTitle}</p>
    </div>
    <div class="flex gap-2 print:hidden">
      <LanguageSwitch currentLocale={locale} />
      <PdfButton />
    </div>
  </div>

  <p class="text-slate-600 leading-relaxed mt-4 mb-5 max-w-2xl">
    {profile.bio}
  </p>

  <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
    {socialLinks.map((link) => (
      <SocialLink
        platform={link.platform}
        url={link.url}
        icon={link.icon}
        iconType={link.iconType}
        label={link.label}
      />
    ))}
  </div>
</header>
